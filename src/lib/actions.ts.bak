// ==========================================
// CIDADES ACTIONS
// ==========================================

export async function getCidades() {
  try {
    return await prisma.cidade.findMany({
      orderBy: { nome: 'asc' },
    })
  } catch (error) {
    console.error('Erro ao buscar cidades:', error)
    return []
  }
}

export async function createCidade(data: { nome: string }) {
  try {
    const existing = await prisma.cidade.findUnique({
      where: { nome: data.nome },
    })
    if (existing) {
      return { success: false, error: 'Cidade já cadastrada.' }
    }
    const cidade = await prisma.cidade.create({
      data: { nome: data.nome },
    })
    revalidatePath('/')
    return { success: true, data: cidade }
  } catch (error) {
    console.error('Erro ao criar cidade:', error)
    return { success: false, error: 'Erro ao criar cidade.' }
  }
}

export async function updateCidade(id: string, data: { nome: string }) {
  try {
    const existing = await prisma.cidade.findFirst({
      where: {
        nome: data.nome,
        NOT: { id },
      },
    })
    if (existing) {
      return { success: false, error: 'Já existe outra cidade com este nome.' }
    }
    const cidade = await prisma.cidade.update({
      where: { id },
      data: { nome: data.nome },
    })
    revalidatePath('/')
    return { success: true, data: cidade }
  } catch (error) {
    console.error('Erro ao atualizar cidade:', error)
    return { success: false, error: 'Erro ao atualizar cidade.' }
  }
}

export async function deleteCidade(id: string) {
  try {
    // Verificar se há eleitores vinculados diretamente à cidade
    const eleitoresCount = await prisma.eleitor.count({
      where: { cidadeId: id },
    })
    if (eleitoresCount > 0) {
      return { success: false, error: 'Não é possível excluir a cidade, pois há eleitores vinculados a ela.' }
    }

    // Verificar se há bairros vinculados à cidade
    const bairrosCount = await prisma.bairro.count({
      where: { cidadeId: id },
    })
    if (bairrosCount > 0) {
      return { success: false, error: 'Não é possível excluir a cidade, pois há bairros vinculados a ela.' }
    }

    await prisma.cidade.delete({
      where: { id },
    })
    revalidatePath('/')
    return { success: true }
  } catch (error) {
    console.error('Erro ao excluir cidade:', error)
    return { success: false, error: 'Erro ao excluir cidade.' }
  }
}

